    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "open-props": "1.7.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
